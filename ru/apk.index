<!-- CHAT -->
<div id="chatbot-toggle">Помощь</div>
<div id="chatbot-box">
  <div id="chatbot-header">Информационный ассистент</div>
  <div id="chatbot-messages">
    <p><strong>Ассистент:</strong> Привет. Я могу помочь с формой, процедурой или компенсацией.</p>
  </div>
  <div id="chatbot-input">
    <input id="chatbot-text" placeholder="Введите вопрос">
    <button onclick="sendMessage()">▶</button>
  </div>
</div>

<script>
let lastTopic = "";

document.getElementById("chatbot-toggle").onclick = () => {
  const box = document.getElementById("chatbot-box");
  box.style.display = box.style.display === "flex" ? "none" : "flex";
};

function sendMessage(){
  const input = document.getElementById("chatbot-text");
  const msg = input.value.trim();
  if(!msg) return;

  const messages = document.getElementById("chatbot-messages");
  messages.innerHTML += `<p><strong>Вы:</strong> ${msg}</p>`;

  let reply = "Ваш вопрос о форме, процедуре или компенсации?";
  const t = msg.toLowerCase();

  if(t.includes("форма")) {
    lastTopic="form";
    reply="Форма используется для предварительной оценки дела. Она доступна на главной странице.";
  } else if(t.includes("где") && lastTopic==="form") {
    reply="Нажмите «Заполнить форму – Оценка дела».";
  } else if(t.includes("что ввести")) {
    reply="Укажите исправительное учреждение, срок заключения и условия в камере.";
  } else if(t.includes("привет") || t.includes("здравствуйте")){
    reply="Здравствуйте. Чем могу помочь?";
  }

  messages.innerHTML += `<p><strong>Ассистент:</strong> ${reply}</p>`;
  input.value="";
  messages.scrollTop = messages.scrollHeight;
}
</script>

